get_iotc_resource <- function(
path,
repo = "iotc-secretariat/iotc-secretariat-resources",
ref = "main"
) {
dest <- file.path(tempdir(), basename(path))
endpoint <- sprintf(
"repos/%s/contents/%s?ref=%s",
repo, path, ref
)
system2(
"gh",
c(
"api",
endpoint,
"-H", "Accept: application/vnd.github.raw+json"
),
stdout = dest
)
dest
}
reference_docx <- get_iotc_resource(
"templates/docx/iotc-working-party.docx"
)
reference_docx
rm(list = ls())
get_iotc_resource <- function(
path,
dest_dir = "templates",
repo = "iotc-secretariat/iotc-secretariat-resources",
ref = "main"
) {
# Create destination directory if necessary
dir.create(dest_dir, recursive = TRUE, showWarnings = FALSE)
dest <- file.path(dest_dir, basename(path))
endpoint <- sprintf(
"repos/%s/contents/%s?ref=%s",
repo, path, ref
)
status <- system2(
"gh",
c(
"api",
endpoint,
"-H", "Accept: application/vnd.github.raw+json"
),
stdout = dest
)
if (status != 0) {
stop("Failed to download IOTC resource: ", path)
}
normalizePath(dest)
}
