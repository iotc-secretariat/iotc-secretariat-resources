get_iotc_resource <- function(
path,
dest_dir = "templates",
repo = "iotc-secretariat/iotc-secretariat-resources",
ref = "main"
) {
dir.create(
dest_dir,
recursive = TRUE,
showWarnings = FALSE
)
dest <- file.path(
dest_dir,
basename(path)
)
endpoint <- sprintf(
"repos/%s/contents/%s?ref=%s",
repo,
path,
ref
)
status <- system2(
"gh",
args = c(
"api",
shQuote(endpoint),
"--header=Accept: application/vnd.github.raw+json"
),
stdout = dest
)
if (status != 0) {
stop(
"Failed to download IOTC resource: ",
path
)
}
dest
}
reference_docx <- get_iotc_resource(
"templates/docx/rdoc_template.docx"
)
get_iotc_resource <- function(
path,
dest_dir = "templates",
repo = "iotc-secretariat/iotc-secretariat-resources",
ref = "main"
) {
gh <- Sys.which("gh")
if (!nzchar(gh)) {
stop("GitHub CLI 'gh' was not found.")
}
dir.create(
dest_dir,
recursive = TRUE,
showWarnings = FALSE
)
dest <- file.path(
dest_dir,
basename(path)
)
tmp <- tempfile(fileext = tools::file_ext(path))
endpoint <- sprintf(
"repos/%s/contents/%s?ref=%s",
repo,
path,
ref
)
status <- system2(
command = gh,
args = c(
"api",
endpoint,
"-H",
"Accept:application/vnd.github.raw+json"
),
stdout = tmp,
stderr = TRUE
)
if (!is.null(attr(status, "status"))) {
stop(
"Failed to download IOTC resource:\n",
paste(status, collapse = "\n")
)
}
if (!file.exists(tmp) || file.size(tmp) == 0) {
stop("GitHub returned an empty file: ", path)
}
copied <- file.copy(
from = tmp,
to = dest,
overwrite = TRUE
)
unlink(tmp)
if (!copied) {
stop("The downloaded file could not be copied to: ", dest)
}
normalizePath(
dest,
winslash = "/",
mustWork = TRUE
)
}
reference_docx <- get_iotc_resource(
"templates/docx/rdoc_template.docx"
)
get_iotc_resource <- function(
path,
dest_dir = "templates",
repo = "iotc-secretariat/iotc-secretariat-resources",
ref = "main"
) {
gh <- Sys.which("gh")
if (!nzchar(gh)) {
stop("GitHub CLI 'gh' was not found.")
}
dir.create(
dest_dir,
recursive = TRUE,
showWarnings = FALSE
)
endpoint <- sprintf(
"repos/%s/contents/%s?ref=%s",
repo,
path,
ref
)
# Get file metadata/content from GitHub
response <- system2(
gh,
args = c(
"api",
endpoint
),
stdout = TRUE,
stderr = TRUE
)
status <- attr(response, "status")
if (!is.null(status) && status != 0) {
stop(
"Failed to download IOTC resource:\n",
paste(response, collapse = "\n")
)
}
# Parse GitHub's JSON response
x <- jsonlite::fromJSON(
paste(response, collapse = "\n")
)
if (is.null(x$content)) {
stop("No file content returned by GitHub for: ", path)
}
# GitHub returns the content Base64-encoded
content <- gsub(
"[\r\n]",
"",
x$content
)
raw <- jsonlite::base64_dec(content)
dest <- file.path(
dest_dir,
basename(path)
)
writeBin(raw, dest)
normalizePath(
dest,
winslash = "/",
mustWork = TRUE
)
}
reference_docx <- get_iotc_resource(
"templates/docx/rdoc_template.docx"
)
